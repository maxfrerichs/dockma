# Merged after dockma.config only for the debug guest (make guest DEBUG=1):
# logging and tracing for the kernel hook. The same olddefconfig gate applies.
CONFIG_DEBUG_KERNEL=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
# dockma_notify.c takes fc->killsb and calls into fuse; lockdep checks the order.
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
