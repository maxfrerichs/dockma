# Kconfig fragment merged onto `make tinyconfig` for the dockma guest kernel.
# Everything is built in (no modules), so the guest needs no module loader.
# The Dockerfile gates the result with moby's contrib/check-config.sh.

# --- Performance: undo tinyconfig's size-first choices --------------------
# tinyconfig builds with -Os and SLUB_TINY. SLUB_TINY gives up the slab
# allocator's scalability and is "not recommended for systems with more than
# 16MB RAM"; the kernel allocates and frees socket buffers per packet.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_SLUB_TINY is not set
# ext4 asks for large page-cache folios, which only exist with THP: about 25 %
# faster sequential writes on the data disk. madvise leaves anonymous memory alone.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# --- Identity ---------------------------------------------------------------
# uname -r and docker info show 6.18.57-dockma: the kernel built for dockma's
# guest, not a distribution's. The Dockerfile sets the build user and host.
CONFIG_LOCALVERSION="-dockma"
# CONFIG_LOCALVERSION_AUTO is not set

# --- Core / syscalls that tinyconfig strips ------------------------------
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_FHANDLE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_1000=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_KEYS=y
CONFIG_PSI=y

# --- Boot ------------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS=y
CONFIG_ARM_GIC_V2M=y
CONFIG_ARM_AMBA=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y

# --- Namespaces and cgroups (cgroup v2) ------------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y

# --- Block, filesystems ------------------------------------------------------
CONFIG_BLOCK=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_INOTIFY_USER=y
# The agent tells the guest's own writes on the home share from the host's echo of them.
CONFIG_FANOTIFY=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

# --- Virtio devices exposed by Virtualization.framework ---------------------
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_TTY=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- Networking ----------------------------------------------------------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_BRIDGE_NETFILTER=y

# --- Netfilter: nftables only (dockerd runs with firewall-backend=nftables) ---
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
# kube-proxy's nftables mode (kind, k3d) load-balances with numgen and hash.
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y

# --- xtables through nftables, for iptables-nft inside containers ----------
# The outer dockerd needs none of this. Docker-in-Docker's dockerd, kind and
# k3s nodes run iptables-nft, which loads xtables matches and targets into
# nftables rules through NFT_COMPAT.
CONFIG_NETFILTER_XTABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
# Not the legacy tables (IP*_NF_IPTABLES_LEGACY, disabled below): these two
# register the per-family xt extensions. Without IP6_NF_IPTABLES, ip6tables
# has no MARK target or addrtype match, and kube-proxy's IPv6 sync fails.
# Each also guards its family's REJECT target.
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
# kube-proxy rejects traffic to Services without endpoints; one rule it
# can't load fails its whole iptables-restore.
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
# kube-proxy: session affinity (recent). k3s network policy: NFLOG. CNIs and
# VPN containers: LOG, CT, CONNMARK, TCPMSS, owner.
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
# iptables-nft turns -j NFLOG into nftables' native log expression.
CONFIG_NFT_LOG=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y

# kind's network policy (kube-network-policies in kindnet) queues new
# connections to userspace and labels the accepted ones in conntrack. It and
# kube-proxy (stale UDP flows) also list and delete conntrack entries.
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NFT_QUEUE=y
CONFIG_NF_CONNTRACK_LABELS=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NETFILTER_NETLINK_GLUE_CT=y

# --- ipset: k3s network policy (kube-router), Calico -----------------------
# All set types: a CNI that needs a missing one fails at runtime.
CONFIG_IP_SET=y
CONFIG_IP_SET_BITMAP_IP=y
CONFIG_IP_SET_BITMAP_IPMAC=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPMARK=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_IPMAC=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_HASH_NETPORTNET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_LIST_SET=y
CONFIG_NETFILTER_XT_SET=y

# --- Overlay networks: flannel's default backend (k3s), Docker's overlay ----
CONFIG_VXLAN=y

# --- Tunnels: /dev/net/tun for VPN containers (Tailscale, WireGuard-go) ----
CONFIG_TUN=y

# --- Diagnostics -------------------------------------------------------------
# /proc/config.gz: without modules, the config is the whole feature list, and
# tools in containers (k3s check-config, moby's check-config.sh) read it.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Not needed in this VM --------------------------------------------------
# Everything is built in; nothing can load code into the kernel at runtime.
# CONFIG_MODULES is not set
# The legacy iptables tables; the guest and its containers use iptables-nft.
# CONFIG_NETFILTER_XTABLES_LEGACY is not set
# CONFIG_IP_NF_IPTABLES_LEGACY is not set
# CONFIG_IP6_NF_IPTABLES_LEGACY is not set
# No keyboard, mouse or VT console: logs and shells use virtio consoles.
# Without GPIOLIB, the device tree's gpio-keys power button never worked;
# the daemon asks the agent to power off instead.
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_IPV6_SIT is not set
# vsock loopback lets processes in the VM, containers included, connect to
# the agent's vsock ports; only the host may.
# CONFIG_VSOCKETS_LOOPBACK is not set
# Virtualization.framework's virtio devices are modern-only (IDs 0x1041+).
# CONFIG_VIRTIO_PCI_LEGACY is not set
# The initramfs is lz4 (legacy format, which is what the kernel reads).
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_ZSTD is not set
