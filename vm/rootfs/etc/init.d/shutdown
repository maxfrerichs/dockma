#!/bin/sh
# Run by init before poweroff: stop dockerd cleanly and quiesce the data disk.
# The wait must outlast dockerd's own shutdown (the larger of its
# shutdown-timeout and each container's stop timeout plus 5 s: 15 s by
# default) and end before the host's hard stop (Daemon.shutdownGrace, 25 s).
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

# dockerd_pid prints dockerd's pid. Not `pidof dockerd`: the init script
# /etc/init.d/dockerd that runs it is also named dockerd, and waiting on both
# ends the wait as soon as that shell exits.
dockerd_pid() {
	pid=$(cat /var/run/docker.pid 2>/dev/null)
	if [ -n "$pid" ] && [ "$(readlink "/proc/$pid/exe")" = /usr/bin/dockerd ]; then
		echo "$pid"
		return 0
	fi
	for pid in $(pidof dockerd); do
		[ "$(readlink "/proc/$pid/exe")" = /usr/bin/dockerd ] && echo "$pid" && return 0
	done
	return 1
}

if pid=$(dockerd_pid); then
	kill -TERM "$pid"
	i=0
	while [ $i -lt 20 ] && kill -0 "$pid" 2>/dev/null; do
		sleep 1
		i=$((i + 1))
	done
	# Whatever still runs would keep files open and the disk mounted
	# read-write; ext4's journal makes the kill safe.
	# shellcheck disable=SC2046 # one argument per pid
	kill -KILL $(pidof dockerd containerd containerd-shim-runc-v2) 2>/dev/null
	sleep 1
fi
sync
umount /var/lib/docker 2>/dev/null || mount -o remount,ro /var/lib/docker 2>/dev/null
sync
