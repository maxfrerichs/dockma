#!/bin/sh
# Brings the system up: pseudo filesystems, network, data disk, host shares.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
log() { echo "dockma: $*"; }
# mark logs a boot phase with the guest uptime; scripts/bench.sh reads these.
mark() { read -r up _ </proc/uptime; log "[$up] $*"; }

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /dev/mqueue
mount -t devpts -o gid=5,mode=620,ptmxmode=666 devpts /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /dev/shm
mount -t mqueue mqueue /dev/mqueue
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t cgroup2 -o nsdelegate cgroup2 /sys/fs/cgroup
mark "filesystems mounted"
ln -sf /proc/self/fd /dev/fd
ln -sf /proc/self/fd/0 /dev/stdin
ln -sf /proc/self/fd/1 /dev/stdout
ln -sf /proc/self/fd/2 /dev/stderr
mkdir -p /var/run /var/lib/docker /run/dockma
hostname dockma

sysctl -q -w net.ipv4.ip_forward=1
sysctl -q -w net.ipv6.conf.all.forwarding=1
sysctl -q -w fs.inotify.max_user_watches=524288
sysctl -q -w fs.inotify.max_user_instances=8192
# Elasticsearch, OpenSearch and SonarQube refuse to start below this.
sysctl -q -w vm.max_map_count=262144

ip link set lo up
ip link set eth0 up
udhcpc -i eth0 -s /usr/share/udhcpc/default.script -t 20 -T 1 -A 2 -b || log "dhcp failed"
mark "network up"

# Persistent data disk: formatted only when blank, checked and mounted
# otherwise. On failure dockma-disk leaves /run/dockma-disk-failed, which
# keeps dockerd from starting on an empty RAM-backed /var/lib/docker.
# Keep this before the home share is mounted: the disk tools run as root and
# must never have the user's real home directory within reach.
if [ -b /dev/vda ]; then
	/usr/libexec/dockma-disk /dev/vda /var/lib/docker
else
	log "no data disk, /var/lib/docker is in RAM"
fi
mark "data disk ready"

# cmdline_path <name>: the percent-encoded path in `dockma.<name>=` on the
# kernel command line, decoded; empty if absent.
cmdline_path() {
	value=$(sed -n "s/.*dockma\\.$1=\\([^ ]*\\).*/\\1/p" /proc/cmdline)
	[ -n "$value" ] && printf "$(echo "$value" | sed 's/%/\\x/g')"
}

# The host home directory is mounted at the same path it has on the host so
# bind mounts like `-v $PWD:/src` resolve.
home=$(cmdline_path home)
if [ -n "$home" ]; then
	mkdir -p "$home"
	mount -t virtiofs home "$home" || log "home share not mounted"
fi

# The state directory (~/.dockma or DOCKMA_HOME) holds the user's guest
# overrides. The guest sees it only when it lies under the home share.
state=$(cmdline_path state)
[ -n "$state" ] || state="$home/.dockma"
echo "$state" >/run/dockma/state
# Extra CA certificates, e.g. for a TLS-intercepting proxy: added to the
# system bundle that dockerd uses for registries.
for cert in "$state"/ca-certificates/*.crt; do
	[ -f "$cert" ] || continue
	{ echo; cat "$cert"; } >>/etc/ssl/certs/ca-certificates.crt && log "added CA certificate $cert"
done
# Per-registry certificates, in Docker's certs.d layout.
if [ -d "$state/certs.d" ]; then
	mkdir -p /etc/docker
	ln -sfn "$state/certs.d" /etc/docker/certs.d
fi

# Rosetta runs x86_64 binaries. The F flag opens the interpreter now, so it
# also works inside containers that don't have /mnt/rosetta.
mkdir -p /mnt/rosetta
if mount -t virtiofs rosetta /mnt/rosetta 2>/dev/null; then
	mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc
	echo ':rosetta:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/mnt/rosetta/rosetta:CF' \
		>/proc/sys/fs/binfmt_misc/register || log "rosetta binfmt registration failed"
fi

mark "boot complete"
